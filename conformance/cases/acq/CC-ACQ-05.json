{
  "id": "CC-ACQ-05",
  "title": "Wrong-state calls raise and send nothing",
  "statements": ["ACQ-07"],
  "timeoutMs": 15000,
  "script": {
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "publish",
      "args": {
        "payload": {
          "k": "v"
        }
      },
      "label": "early"
    },
    {
      "op": "start",
      "label": "s1"
    },
    {
      "op": "start",
      "label": "s2"
    }
  ],
  "expect": [
    {
      "kind": "observation",
      "command": "early",
      "ok": false,
      "error": {
        "type": "ClientStateError"
      }
    },
    {
      "kind": "observation",
      "command": "s1",
      "ok": true
    },
    {
      "kind": "observation",
      "command": "s2",
      "ok": false,
      "error": {
        "type": "ClientStateError"
      }
    },
    {
      "kind": "request-count",
      "match": {
        "listener": "S4"
      },
      "count": 0
    },
    {
      "kind": "request-count",
      "match": {
        "path": "/agent-credentials"
      },
      "count": 1
    }
  ]
}
