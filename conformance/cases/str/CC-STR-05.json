{
  "id": "CC-STR-05",
  "title": "The old stream never sends end: closed after W_super",
  "statements": ["STR-05"],
  "$comment": "T_idle is 10000 ms, above this case's longest silence (the old stream waits about 2 s for the replacement subscribe): the stub cannot script heartbeats during a wait, so T_idle must exceed the case's longest silence, or the SDK rightly ends the stream as idle (STR-02).",
  "timeoutMs": 15000,
  "values": {
    "H_renew": 1000,
    "R_max": 3,
    "W_max": 4000,
    "B_init": 100,
    "B_factor": 2,
    "B_cap": 400,
    "L_ends": 6,
    "W_super": 1000,
    "N_buf": 8,
    "T_idle": 10000,
    "T_req": 2000,
    "R_min": 1
  },
  "script": {
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+3000}"
          }
        }
      },
      {
        "label": "renew",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials/current/renewal"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.two",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      },
      {
        "label": "s1",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/subscriptions"
        },
        "respond": {
          "stream": [
            {
              "delivery": {
                "label": "d1",
                "envelope": {
                  "fixture": "envelope/valid/sample.json"
                },
                "seal": "seal-1",
                "payload": {
                  "json": {
                    "k": "v"
                  }
                }
              }
            },
            {
              "waitFor": {
                "match": {
                  "path": "/subscriptions"
                },
                "count": 2,
                "timeoutMs": 5000
              }
            },
            {
              "hold": true
            }
          ]
        }
      },
      {
        "label": "s2",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/subscriptions"
        },
        "respond": {
          "stream": [
            {
              "delivery": {
                "label": "d3",
                "envelope": {
                  "fixture": "envelope/valid/sample.json"
                },
                "seal": "seal-1",
                "payload": {
                  "json": {
                    "k": "v"
                  }
                }
              }
            },
            {
              "hold": true
            }
          ]
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "subscribe",
      "label": "sub"
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 5000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 5000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 5000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 5000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 5000
      }
    }
  ],
  "expect": [
    {
      "kind": "item-sequence",
      "items": [
        {
          "kind": "streamStarted"
        },
        {
          "kind": "delivery",
          "envelopeTextOf": "d1",
          "sealOf": "d1"
        },
        {
          "kind": "streamEnded",
          "code": null,
          "terminal": false
        },
        {
          "kind": "streamStarted"
        },
        {
          "kind": "delivery",
          "envelopeTextOf": "d3",
          "sealOf": "d3"
        }
      ]
    },
    {
      "kind": "request-timing",
      "request": {
        "path": "/subscriptions",
        "nth": 2
      },
      "value": "H_renew",
      "notBefore": "${TIME:+1000}",
      "notAfter": "${TIME:+3000}"
    }
  ]
}
