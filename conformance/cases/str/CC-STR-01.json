{
  "id": "CC-STR-01",
  "title": "Known non-terminal codes surface and a new stream follows",
  "statements": ["STR-02", "STR-03"],
  "$comment": "The second end carries an unknown member (the StreamEnd unknown-field fixture).",
  "fixtures": ["event-ingest/StreamEnd/valid/unknown-field.json"],
  "timeoutMs": 20000,
  "values": {
    "H_renew": 1000,
    "R_max": 3,
    "W_max": 4000,
    "B_init": 100,
    "B_factor": 2,
    "B_cap": 400,
    "L_ends": 6,
    "W_super": 1000,
    "N_buf": 8,
    "T_idle": 1500,
    "T_req": 2000
  },
  "script": {
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      },
      {
        "label": "s1",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/subscriptions"
        },
        "respond": {
          "stream": [
            {
              "end": "unavailable"
            }
          ]
        }
      },
      {
        "label": "s2",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/subscriptions"
        },
        "respond": {
          "stream": [
            {
              "endData": "{\"code\":\"overflow\",\"note\":\"x\"}"
            }
          ]
        }
      },
      {
        "label": "s3",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/subscriptions"
        },
        "respond": {
          "stream": [
            {
              "hold": true
            }
          ]
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "subscribe",
      "label": "sub"
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 4000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 4000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 4000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 4000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 4000
      }
    }
  ],
  "expect": [
    {
      "kind": "item-sequence",
      "items": [
        {
          "kind": "streamStarted"
        },
        {
          "kind": "streamEnded",
          "code": "unavailable",
          "terminal": false
        },
        {
          "kind": "streamStarted"
        },
        {
          "kind": "streamEnded",
          "code": "overflow",
          "terminal": false
        },
        {
          "kind": "streamStarted"
        }
      ]
    },
    {
      "kind": "request-count",
      "match": {
        "path": "/subscriptions"
      },
      "count": 3
    }
  ]
}
