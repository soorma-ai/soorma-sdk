{
  "id": "CC-TRC-01",
  "title": "The draft carries the send span's context",
  "statements": ["DRF-02", "TRC-01", "TRC-02"],
  "timeoutMs": 15000,
  "script": {
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      },
      {
        "label": "pub",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "status": 202
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        },
        "otel": true
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "publish",
      "args": {
        "payload": {
          "k": "v"
        },
        "inSpan": {
          "name": "tenant-op"
        }
      },
      "label": "p"
    },
    {
      "op": "spans",
      "label": "sp"
    }
  ],
  "expect": [
    {
      "kind": "request-shape",
      "request": {
        "path": "/events"
      },
      "bodyAt": {
        "/draft/traceContext/traceparent": {
          "matches": "^00-(?!0{32})[0-9a-f]{32}-(?!0{16})[0-9a-f]{16}-[0-9a-f]{2}$"
        }
      }
    },
    {
      "kind": "span",
      "command": "sp",
      "spans": [
        {
          "kind": "producer",
          "sameAs": {
            "draftOf": "p"
          },
          "parent": {
            "tenantSpanOf": "p"
          }
        }
      ]
    }
  ]
}
