{
  "id": "CC-FWD-02",
  "title": "The forwarded envelope is the received text, byte for byte",
  "statements": ["FWD-02"],
  "$comment": "The envelope text has unusual member order, spacing and numbers spelled 1.0: re-serializing it changes its bytes.",
  "fixtures": [
    "inbound/valid/envelope-with-unknown-fields.json",
    "envelope/valid/unknown-fields-at-every-level.json"
  ],
  "timeoutMs": 15000,
  "script": {
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      },
      {
        "label": "sub",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/subscriptions"
        },
        "respond": {
          "stream": [
            {
              "delivery": {
                "label": "d1",
                "envelope": {
                  "text": "{\"traceContext\" : {\"traceparent\":\"00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01\", \"x-future\":1.0},\"actorChain\":[{\"instance\":\"host-1:4100\",\"agent\":\"agent-a\"}],\"originMode\":\"autonomous\",\"scope\":{\"environment\":\"e1\",\"project\":\"p1\",\"organization\":\"o1\"},  \"envelopeVersion\":1,\"x-future\":1.0}"
                },
                "seal": "seal-1",
                "payload": {
                  "json": {
                    "k": "v"
                  }
                }
              }
            },
            {
              "hold": true
            }
          ]
        }
      },
      {
        "label": "pub",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "status": 202
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "subscribe",
      "label": "sub"
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 3000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 3000
      }
    },
    {
      "op": "forward",
      "args": {
        "ref": "1",
        "payload": {
          "r": 1
        }
      },
      "label": "f"
    }
  ],
  "expect": [
    {
      "kind": "request-exact",
      "request": {
        "path": "/events"
      },
      "at": "/draft/inbound/envelope",
      "equalsEnvelopeOf": "d1"
    }
  ]
}
