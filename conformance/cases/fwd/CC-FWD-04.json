                "seal": "seal-1",
                "payload": {
                  "json": {
                    "k": "v"
                  }
                }
              }
            },
            {
              "hold": true
            }
          ]
        }
      },
      {
        "label": "pub",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
