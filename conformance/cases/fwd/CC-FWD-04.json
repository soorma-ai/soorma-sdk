    }
  ],
  "expect": [
    {
      "kind": "request-shape",
      "request": {
        "path": "/events"
      },
      "bodyAt": {
        "/draft/traceContext/traceparent": {
          "matches": "^00-4bf92f3577b34da6a3ce929d0e0e4736-(?!00f067aa0ba902b7)[0-9a-f]{16}-[0-9a-f]{2}$"
        }
      }
    },
    {
      "kind": "span",
      "command": "sp",
      "spans": [
        {
          "kind": "producer",
          "sameAs": {
            "draftOf": "f"
          },
          "parent": {
            "receivedOf": "d1"
          }
        }
      ]
    }
  ]
}
