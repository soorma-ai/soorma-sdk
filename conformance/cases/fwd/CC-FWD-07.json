{
  "id": "CC-FWD-07",
  "title": "Refused forwarding surfaces as given, once each",
  "statements": ["FWD-05"],
  "timeoutMs": 15000,
  "script": {
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      },
      {
        "label": "sub",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/subscriptions"
        },
        "respond": {
          "stream": [
            {
              "delivery": {
                "label": "d1",
                "envelope": {
                  "fixture": "envelope/valid/sample.json"
                },
                "seal": "seal-1",
                "payload": {
                  "json": {
                    "k": "v"
                  }
                }
              }
            },
            {
              "hold": true
            }
          ]
        }
      },
      {
        "label": "e1",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "status": 400,
          "json": {
            "type": "urn:soorma:problem:invalid_inbound_context",
            "title": "invalid_inbound_context",
            "status": 400,
            "code": "invalid_inbound_context"
          }
        }
      },
      {
        "label": "e2",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "status": 400,
          "json": {
            "type": "urn:soorma:problem:chain_too_deep",
            "title": "chain_too_deep",
            "status": 400,
            "code": "chain_too_deep"
          }
        }
      },
      {
        "label": "e3",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "status": 403,
          "json": {
            "type": "urn:soorma:problem:forbidden",
            "title": "forbidden",
            "status": 403,
            "code": "forbidden"
          }
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "subscribe",
      "label": "sub"
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 3000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 3000
      }
    },
    {
      "op": "forward",
      "args": {
        "ref": "1",
        "payload": 1
      },
      "label": "f1"
    },
    {
      "op": "forward",
      "args": {
        "ref": "1",
        "payload": 2
      },
      "label": "f2"
    },
    {
      "op": "forward",
      "args": {
        "ref": "1",
        "payload": 3
      },
      "label": "f3"
    },
    {
      "op": "wait",
      "args": {
        "ms": 300
      }
    }
  ],
  "expect": [
    {
      "kind": "observation",
      "command": "f1",
      "ok": false,
      "error": {
        "type": "ProblemError",
        "status": 400,
        "code": "invalid_inbound_context"
      }
    },
    {
      "kind": "observation",
      "command": "f2",
      "ok": false,
      "error": {
        "type": "ProblemError",
        "status": 400,
        "code": "chain_too_deep"
      }
    },
    {
      "kind": "observation",
      "command": "f3",
      "ok": false,
      "error": {
        "type": "ProblemError",
        "status": 403,
        "code": "forbidden"
      }
    },
    {
      "kind": "request-count",
      "match": {
        "path": "/events"
      },
      "count": 3
    }
  ]
}
