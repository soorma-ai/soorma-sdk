{
  "id": "CC-FWD-01",
  "title": "delivery.publish forwards by default",
  "statements": ["FWD-01"],
  "fixtures": ["inbound/valid/sample.json", "draft/valid/forwarding.json"],
  "negativeFixtures": ["inbound/invalid/*"],
  "timeoutMs": 15000,
  "script": {
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      },
      {
        "label": "sub",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/subscriptions"
        },
        "respond": {
          "stream": [
            {
              "delivery": {
                "label": "d1",
                "envelope": {
                  "fixture": "envelope/valid/sample.json"
                },
                "seal": "seal-1",
                "payload": {
                  "json": {
                    "k": "v"
                  }
                }
              }
            },
            {
              "hold": true
            }
          ]
        }
      },
      {
        "label": "pub",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "status": 202
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "subscribe",
      "label": "sub"
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 3000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 3000
      }
    },
    {
      "op": "forward",
      "args": {
        "ref": "1",
        "payload": {
          "r": 1
        }
      },
      "label": "f"
    }
  ],
  "expect": [
    {
      "kind": "observation",
      "command": "f",
      "ok": true
    },
    {
      "kind": "request-shape",
      "request": {
        "path": "/events"
      },
      "members": {
        "at": "/draft/inbound",
        "exactly": ["envelope", "seal"]
      },
      "schema": "Inbound",
      "schemaAt": "/draft/inbound",
      "positives": ["inbound/valid/sample.json"],
      "negativesFrom": "inbound/"
    },
    {
      "kind": "request-shape",
      "request": {
        "path": "/events"
      },
      "schema": "Draft",
      "schemaAt": "/draft",
      "positives": ["draft/valid/forwarding.json"]
    }
  ]
}
