{
  "id": "CC-PUB-03",
  "title": "A failed publish is never retried",
  "statements": ["PUB-05", "PRB-10", "PRB-06"],
  "$comment": "The second publish is reset after its request was written: sent, no answer. Neither is retried.",
  "timeoutMs": 15000,
  "script": {
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      },
      {
        "label": "e1",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "status": 503,
          "json": {
            "type": "urn:soorma:problem:unavailable",
            "title": "unavailable",
            "status": 503,
            "code": "unavailable"
          },
          "headers": {
            "Retry-After": "1"
          }
        }
      },
      {
        "label": "e2",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "reset": true
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "publish",
      "args": {
        "payload": 1
      },
      "label": "p1"
    },
    {
      "op": "publish",
      "args": {
        "payload": 2
      },
      "label": "p2"
    },
    {
      "op": "wait",
      "args": {
        "ms": 1500
      }
    }
  ],
  "expect": [
    {
      "kind": "observation",
      "command": "p1",
      "ok": false,
      "error": {
        "type": "ProblemError",
        "status": 503,
        "code": "unavailable",
        "retryAfter": 1
      }
    },
    {
      "kind": "observation",
      "command": "p2",
      "ok": false,
      "error": {
        "type": "TransportError"
      }
    },
    {
      "kind": "request-count",
      "match": {
        "path": "/events"
      },
      "count": 2
    }
  ]
}
