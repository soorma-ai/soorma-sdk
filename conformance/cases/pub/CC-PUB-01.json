{
  "id": "CC-PUB-01",
  "title": "A 202 is accepted, not delivered",
  "statements": ["PUB-01", "PUB-02", "PUB-04"],
  "fixtures": [
    "event-ingest/PublishRequest/valid/sample.json",
    "event-ingest/PublishRequest/valid/payload-null.json",
    "event-ingest/PublishRequest/valid/forwarding.json"
  ],
  "negativeFixtures": ["event-ingest/PublishRequest/invalid/*"],
  "timeoutMs": 15000,
  "script": {
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      },
      {
        "label": "pub",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "status": 202
        },
        "times": 3
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "publish",
      "args": {
        "payload": {
          "k": "v"
        }
      },
      "label": "p1"
    },
    {
      "op": "publish",
      "args": {
        "payload": null
      },
      "label": "p2"
    },
    {
      "op": "publish",
      "args": {
        "payload": [1, "two"]
      },
      "label": "p3"
    }
  ],
  "expect": [
    {
      "kind": "observation",
      "command": "p1",
      "ok": true,
      "result": {
        "/traceContext/traceparent": {
          "matches": "^00-(?!0{32})[0-9a-f]{32}-(?!0{16})[0-9a-f]{16}-[0-9a-f]{2}$"
        },
        "/delivered": {
          "exists": false
        }
      }
    },
    {
      "kind": "observation",
      "command": "p2",
      "ok": true,
      "result": {
        "/traceContext/traceparent": {
          "matches": "^00-(?!0{32})[0-9a-f]{32}-(?!0{16})[0-9a-f]{16}-[0-9a-f]{2}$"
        },
        "/delivered": {
          "exists": false
        }
      }
    },
    {
      "kind": "observation",
      "command": "p3",
      "ok": true,
      "result": {
        "/traceContext/traceparent": {
          "matches": "^00-(?!0{32})[0-9a-f]{32}-(?!0{16})[0-9a-f]{16}-[0-9a-f]{2}$"
        },
        "/delivered": {
          "exists": false
        }
      }
    },
    {
      "kind": "request-shape",
      "request": {
        "path": "/events",
        "nth": 1
      },
      "members": {
        "exactly": ["draft", "payload"]
      },
      "bodyAt": {
        "/payload": {
          "k": "v"
        }
      },
      "schema": "event-ingest#PublishRequest",
      "positives": [
        "event-ingest/PublishRequest/valid/sample.json",
        "event-ingest/PublishRequest/valid/payload-null.json",
        "event-ingest/PublishRequest/valid/forwarding.json"
      ],
      "negativesFrom": "event-ingest/PublishRequest/"
    },
    {
      "kind": "request-shape",
      "request": {
        "path": "/events",
        "nth": 2
      },
      "bodyAt": {
        "/payload": null
      }
    },
    {
      "kind": "request-shape",
      "request": {
        "path": "/events",
        "nth": 3
      },
      "bodyAt": {
        "/payload": [1, "two"]
      }
    }
  ]
}
