{
  "id": "CC-PUB-04",
  "title": "payload_too_large and other Problems surface",
  "statements": ["PUB-06"],
  "timeoutMs": 15000,
  "script": {
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      },
      {
        "label": "pub",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "status": 413,
          "json": {
            "type": "urn:soorma:problem:payload_too_large",
            "title": "payload_too_large",
            "status": 413,
            "code": "payload_too_large"
          }
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "publish",
      "args": {
        "payload": {
          "big": "x"
        }
      },
      "label": "p"
    }
  ],
  "expect": [
    {
      "kind": "observation",
      "command": "p",
      "ok": false,
      "error": {
        "type": "ProblemError",
        "status": 413,
        "code": "payload_too_large"
      }
    }
  ]
}
