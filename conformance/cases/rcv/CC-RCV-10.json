{
  "id": "CC-RCV-10",
  "title": "A non-stream response body over B_body is a transport error",
  "statements": ["RCV-09"],
  "$comment": "The publish is answered 413 with a Problem whose detail member, generated at send time, makes the body B_body plus 1 KiB. The SDK reports TransportError response-too-large, not the Problem, and never retries the publish.",
  "timeoutMs": 15000,
  "script": {
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      },
      {
        "label": "pub",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "status": 413,
          "json": {
            "type": "urn:soorma:problem:payload_too_large",
            "title": "payload_too_large",
            "status": 413,
            "code": "payload_too_large"
          },
          "generate": {
            "bytes": "${VALUE:B_body+1024}",
            "line": "filler",
            "member": "detail"
          }
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "publish",
      "args": {
        "payload": {
          "k": "v"
        }
      },
      "label": "p"
    }
  ],
  "expect": [
    {
      "kind": "observation",
      "command": "p",
      "ok": false,
      "error": {
        "type": "TransportError",
        "reason": "response-too-large"
      }
    },
    {
      "kind": "request-count",
      "match": {
        "path": "/events"
      },
      "count": 1
    }
  ]
}
