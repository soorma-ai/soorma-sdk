{
  "id": "CC-RCV-09",
  "title": "An SSE event over L_event is a delivery error; the next Delivery still arrives",
  "statements": ["RCV-09"],
  "$comment": "One event of many data: lines, each 1000 bytes (far under 1 MiB), together L_event plus 64 KiB, generated by the stub at send time; then a normal Delivery. The stream stays open (one subscribe, no further item). The case's silences are under the driver's T_idle (the case authors' rule).",
  "timeoutMs": 20000,
  "script": {
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      },
      {
        "label": "sub",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/subscriptions"
        },
        "respond": {
          "stream": [
            {
              "generate": {
                "event": "delivery",
                "bytes": "${VALUE:L_event+65536}",
                "line": ""
              }
            },
            {
              "delivery": {
                "label": "ok",
                "envelope": {
                  "fixture": "envelope/valid/sample.json"
                },
                "seal": "seal-1",
                "payload": {
                  "json": {
                    "k": "v"
                  }
                }
              }
            },
            {
              "hold": true
            }
          ]
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "subscribe",
      "label": "sub"
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 5000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 5000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 5000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 5000
      }
    }
  ],
  "expect": [
    {
      "kind": "item-sequence",
      "items": [
        {
          "kind": "streamStarted"
        },
        {
          "kind": "deliveryError",
          "reason": "event-too-large",
          "text": ""
        },
        {
          "kind": "delivery",
          "envelopeTextOf": "ok",
          "sealOf": "ok"
        }
      ]
    },
    {
      "kind": "request-count",
      "match": {
        "path": "/subscriptions"
      },
      "count": 1
    }
  ]
}
