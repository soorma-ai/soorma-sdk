{
  "id": "CC-RCV-05",
  "title": "Native numbers, with the exact source text",
  "statements": ["RCV-05"],
  "fixtures": ["delivery/valid/payload-array.json", "delivery/valid/payload-null.json"],
  "timeoutMs": 15000,
  "script": {
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      },
      {
        "label": "sub",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/subscriptions"
        },
        "respond": {
          "stream": [
            {
              "delivery": {
                "label": "n1",
                "envelope": {
                  "fixture": "envelope/valid/sample.json"
                },
                "seal": "seal-1",
                "payload": {
                  "text": "[1.0,1e400,123456789012345678901234567890]"
                }
              }
            },
            {
              "delivery": {
                "label": "n2",
                "fixture": "delivery/valid/payload-array.json"
              }
            },
            {
              "delivery": {
                "label": "n3",
                "fixture": "delivery/valid/payload-null.json"
              }
            },
            {
              "hold": true
            }
          ]
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "subscribe",
      "label": "sub"
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 3000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 3000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 3000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 3000
      }
    }
  ],
  "expect": [
    {
      "kind": "item-sequence",
      "items": [
        {
          "kind": "streamStarted"
        },
        {
          "kind": "delivery",
          "envelopeTextOf": "n1",
          "sealOf": "n1",
          "payloadText": "[1.0,1e400,123456789012345678901234567890]",
          "payloadParsed": true
        },
        {
          "kind": "delivery",
          "payload": [1, "two"],
          "payloadText": "[1,\"two\"]"
        },
        {
          "kind": "delivery",
          "payload": null,
          "payloadText": "null"
        }
      ]
    }
  ]
}
