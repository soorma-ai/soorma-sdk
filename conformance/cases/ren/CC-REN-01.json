{
  "id": "CC-REN-01",
  "title": "Renewal before expiry; the renewed credential is used",
  "statements": ["REN-01", "REN-02"],
  "timeoutMs": 12000,
  "values": {
    "H_renew": 1000,
    "R_max": 3,
    "W_max": 4000,
    "B_init": 100,
    "B_factor": 2,
    "B_cap": 400,
    "L_ends": 6,
    "W_super": 1000,
    "N_buf": 8,
    "T_idle": 1500,
    "T_req": 2000,
    "R_min": 1
  },
  "script": {
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+4000}"
          }
        }
      },
      {
        "label": "renew",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials/current/renewal"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.two",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      },
      {
        "label": "pub",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "status": 202
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "waitForRequest",
      "args": {
        "match": {
          "path": "/agent-credentials/current/renewal"
        },
        "timeoutMs": 5000
      }
    },
    {
      "op": "wait",
      "args": {
        "ms": 200
      }
    },
    {
      "op": "publish",
      "args": {
        "payload": {
          "k": "v"
        }
      },
      "label": "p"
    },
    {
      "op": "credential",
      "label": "cred"
    }
  ],
  "expect": [
    {
      "kind": "request-timing",
      "request": {
        "path": "/agent-credentials/current/renewal"
      },
      "value": "H_renew",
      "notBefore": "${TIME:+1000}",
      "notAfter": "${TIME:+4000}"
    },
    {
      "kind": "request-shape",
      "request": {
        "path": "/agent-credentials/current/renewal"
      },
      "noBody": true,
      "headers": {
        "equals": {
          "authorization": "Bearer soorma_ac_token.one"
        }
      }
    },
    {
      "kind": "request-shape",
      "request": {
        "path": "/events"
      },
      "headers": {
        "equals": {
          "authorization": "Bearer soorma_ac_token.two"
        }
      }
    },
    {
      "kind": "observation",
      "command": "cred",
      "result": {
        "/credential/expiresAt": "${TIME:+600000}"
      }
    }
  ]
}
