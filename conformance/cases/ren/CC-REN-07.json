{
  "id": "CC-REN-07",
  "title": "After the clock-skew warning, S3 judges expiry: no bootstrap before operations, one on credential_expired",
  "statements": ["REN-07"],
  "timeoutMs": 12000,
  "values": {
    "H_renew": 2000,
    "R_max": 3,
    "W_max": 4000,
    "B_init": 100,
    "B_factor": 2,
    "B_cap": 400,
    "L_ends": 6,
    "W_super": 1000,
    "N_buf": 8,
    "T_idle": 1500,
    "T_req": 2000,
    "R_min": 1500
  },
  "script": {
    "exchanges": [
      {
        "label": "boot1",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+-60000}"
          }
        }
      },
      {
        "label": "pub1",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "status": 202
        },
        "times": 3
      },
      {
        "label": "renew",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials/current/renewal"
        },
        "respond": {
          "status": 401,
          "json": {
            "type": "urn:soorma:problem:credential_expired",
            "title": "credential_expired",
            "status": 401,
            "code": "credential_expired"
          }
        }
      },
      {
        "label": "boot2",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.two",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      },
      {
        "label": "pub2",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "status": 202
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "publish",
      "args": {
        "payload": {
          "n": 1
        }
      },
      "label": "p1"
    },
    {
      "op": "publish",
      "args": {
        "payload": {
          "n": 2
        }
      },
      "label": "p2"
    },
    {
      "op": "publish",
      "args": {
        "payload": {
          "n": 3
        }
      },
      "label": "p3"
    },
    {
      "op": "waitForRequest",
      "args": {
        "match": {
          "path": "/agent-credentials/current/renewal"
        },
        "timeoutMs": 5000
      }
    },
    {
      "op": "waitForRequest",
      "args": {
        "match": {
          "path": "/agent-credentials"
        },
        "count": 2,
        "timeoutMs": 5000
      }
    },
    {
      "op": "wait",
      "args": {
        "ms": 300
      }
    },
    {
      "op": "publish",
      "args": {
        "payload": {
          "n": 4
        }
      },
      "label": "p4"
    },
    {
      "op": "warnings",
      "label": "w"
    },
    {
      "op": "inspect",
      "args": {
        "checks": ["providerCalls"]
      },
      "label": "insp"
    }
  ],
  "expect": [
    {
      "kind": "observation",
      "command": "p1",
      "ok": true
    },
    {
      "kind": "observation",
      "command": "p2",
      "ok": true
    },
    {
      "kind": "observation",
      "command": "p3",
      "ok": true
    },
    {
      "kind": "observation",
      "command": "p4",
      "ok": true
    },
    {
      "kind": "request-count",
      "match": {
        "path": "/agent-credentials"
      },
      "count": 2
    },
    {
      "kind": "request-count",
      "match": {
        "path": "/agent-credentials/current/renewal"
      },
      "count": 1
    },
    {
      "kind": "request-shape",
      "request": {
        "path": "/events",
        "nth": 1
      },
      "headers": {
        "equals": {
          "authorization": "Bearer soorma_ac_token.one"
        }
      }
    },
    {
      "kind": "request-shape",
      "request": {
        "path": "/events",
        "nth": 3
      },
      "headers": {
        "equals": {
          "authorization": "Bearer soorma_ac_token.one"
        }
      }
    },
    {
      "kind": "request-shape",
      "request": {
        "path": "/events",
        "nth": 4
      },
      "headers": {
        "equals": {
          "authorization": "Bearer soorma_ac_token.two"
        }
      }
    },
    {
      "kind": "request-timing",
      "request": {
        "path": "/agent-credentials",
        "nth": 2
      },
      "afterRequest": {
        "path": "/agent-credentials/current/renewal"
      }
    },
    {
      "kind": "observation",
      "command": "insp",
      "result": {
        "/providerCalls": 2
      }
    },
    {
      "kind": "observation",
      "command": "w",
      "result": {
        "/warnings": [
          {
            "code": "clock-skew"
          }
        ]
      }
    }
  ],
  "$comment": "The first credential's expiresAt is a minute before the case started: past on the client's clock. After the warning the client does not bootstrap before the three publishes; the floored renewal is answered credential_expired, and the client bootstraps once (REN-04)."
}
