{
  "id": "CC-REN-06",
  "title": "A credential already due: renewals at most once per R_min, one clock-skew warning",
  "statements": ["REN-07"],
  "timeoutMs": 12000,
  "values": {
    "H_renew": 2000,
    "R_max": 3,
    "W_max": 4000,
    "B_init": 100,
    "B_factor": 2,
    "B_cap": 400,
    "L_ends": 6,
    "W_super": 1000,
    "N_buf": 8,
    "T_idle": 1500,
    "T_req": 2000,
    "R_min": 600
  },
  "script": {
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": {
              "$expiresIn": 1000
            }
          }
        }
      },
      {
        "label": "renew",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials/current/renewal"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.two",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": {
              "$expiresIn": 1000
            }
          }
        },
        "times": 20
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "wait",
      "args": {
        "ms": 3000
      }
    },
    {
      "op": "warnings",
      "label": "w"
    }
  ],
  "expect": [
    {
      "kind": "observation",
      "command": "start",
      "ok": true
    },
    {
      "kind": "request-timing",
      "request": {
        "path": "/agent-credentials/current/renewal",
        "nth": 1
      },
      "afterRequest": {
        "path": "/agent-credentials"
      },
      "minAfterMs": 500
    },
    {
      "kind": "request-timing",
      "requests": {
        "path": "/agent-credentials/current/renewal"
      },
      "minGapMs": 500
    },
    {
      "kind": "request-count",
      "match": {
        "path": "/agent-credentials/current/renewal"
      },
      "min": 2,
      "max": 6
    },
    {
      "kind": "request-count",
      "match": {
        "path": "/agent-credentials"
      },
      "count": 1
    },
    {
      "kind": "observation",
      "command": "w",
      "result": {
        "/warnings": [
          {
            "code": "clock-skew"
          }
        ]
      }
    }
  ],
  "$comment": "Each expiry is 1000 ms after the stub's response ($expiresIn), inside H_renew (2000 ms): every credential is due on arrival. The floor R_min (600 ms) spaces the renewals (minGapMs 500 allows 100 ms of loopback jitter); one warning for the one lineage."
}
