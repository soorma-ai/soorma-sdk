{
  "id": "CC-REN-04",
  "title": "credential_refused on renewal is terminal",
  "statements": ["REN-05"],
  "timeoutMs": 12000,
  "values": {
    "H_renew": 1000,
    "R_max": 3,
    "W_max": 4000,
    "B_init": 100,
    "B_factor": 2,
    "B_cap": 400,
    "L_ends": 6,
    "W_super": 1000,
    "N_buf": 8,
    "T_idle": 1500,
    "T_req": 2000
  },
  "script": {
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+3000}"
          }
        }
      },
      {
        "label": "renew",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials/current/renewal"
        },
        "respond": {
          "status": 401,
          "json": {
            "type": "urn:soorma:problem:credential_refused",
            "title": "credential_refused",
            "status": 401,
            "code": "credential_refused"
          }
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "waitForRequest",
      "args": {
        "match": {
          "path": "/agent-credentials/current/renewal"
        },
        "timeoutMs": 5000
      }
    },
    {
      "op": "wait",
      "args": {
        "ms": 500
      }
    },
    {
      "op": "publish",
      "args": {
        "payload": {
          "k": "v"
        }
      },
      "label": "p"
    }
  ],
  "expect": [
    {
      "kind": "observation",
      "command": "p",
      "ok": false,
      "error": {
        "type": "ClientStateError"
      }
    },
    {
      "kind": "request-count",
      "match": {
        "path": "/agent-credentials"
      },
      "count": 1
    },
    {
      "kind": "request-count",
      "match": {
        "path": "/events"
      },
      "count": 0
    }
  ]
}
