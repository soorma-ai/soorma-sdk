{
  "id": "CC-SUB-06",
  "title": "Pull-based: a slow consumer meets overflow, surfaced, then a new stream",
  "statements": ["SUB-06"],
  "$comment": "The consumer pulls nothing for a second; the stub ends the stream with overflow as the platform does when its buffer fills.",
  "timeoutMs": 20000,
  "values": {
    "H_renew": 1000,
    "R_max": 3,
    "W_max": 4000,
    "B_init": 100,
    "B_factor": 2,
    "B_cap": 400,
    "L_ends": 6,
    "W_super": 1000,
    "N_buf": 8,
    "T_idle": 1500,
    "T_req": 2000
  },
  "script": {
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      },
      {
        "label": "s1",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/subscriptions"
        },
        "respond": {
          "stream": [
            {
              "delivery": {
                "label": "d1",
                "envelope": {
                  "fixture": "envelope/valid/sample.json"
                },
                "seal": "seal-1",
                "payload": {
                  "json": {
                    "k": "v"
                  }
                }
              }
            },
            {
              "delivery": {
                "label": "d2",
                "envelope": {
                  "fixture": "envelope/valid/sample.json"
                },
                "seal": "seal-1",
                "payload": {
                  "json": {
                    "k": "v"
                  }
                }
              }
            },
            {
              "delivery": {
                "label": "d3",
                "envelope": {
                  "fixture": "envelope/valid/sample.json"
                },
                "seal": "seal-1",
                "payload": {
                  "json": {
                    "k": "v"
                  }
                }
              }
            },
            {
              "end": "overflow"
            }
          ]
        }
      },
      {
        "label": "s2",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/subscriptions"
        },
        "respond": {
          "stream": [
            {
              "hold": true
            }
          ]
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "subscribe",
      "label": "sub"
    },
    {
      "op": "wait",
      "args": {
        "ms": 1000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 3000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 3000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 3000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 3000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 3000
      }
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 3000
      }
    }
  ],
  "expect": [
    {
      "kind": "item-sequence",
      "items": [
        {
          "kind": "streamStarted"
        },
        {
          "kind": "delivery",
          "envelopeTextOf": "d1",
          "sealOf": "d1"
        },
        {
          "kind": "delivery",
          "envelopeTextOf": "d2",
          "sealOf": "d2"
        },
        {
          "kind": "delivery",
          "envelopeTextOf": "d3",
          "sealOf": "d3"
        },
        {
          "kind": "streamEnded",
          "code": "overflow",
          "terminal": false
        },
        {
          "kind": "streamStarted"
        }
      ]
    },
    {
      "kind": "request-count",
      "match": {
        "path": "/subscriptions"
      },
      "count": 2
    }
  ]
}
