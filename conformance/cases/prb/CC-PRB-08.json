{
  "id": "CC-PRB-08",
  "title": "A reset after sending: subscribe, renewal and bootstrap retried; publish not",
  "statements": ["PRB-09", "PRB-10"],
  "$comment": "Each first request is read whole, then its connection reset with no answer. The subscribe is retried once (s1 reset, s2 held); after the renewal STR-04 requires a replacement subscribe, answered by s3 with a held stream; the case checks the observable outcomes listed. T_idle is 10000 ms, above this case's longest silence (s2 is held without data for the rest of the case): the stub cannot script heartbeats during a wait, so T_idle must exceed the case's longest silence, or the SDK rightly ends the stream as idle and resubscribes (STR-02).",
  "timeoutMs": 15000,
  "values": {
    "H_renew": 1000,
    "R_max": 3,
    "W_max": 4000,
    "B_init": 100,
    "B_factor": 2,
    "B_cap": 400,
    "L_ends": 6,
    "W_super": 1000,
    "N_buf": 8,
    "T_idle": 10000,
    "T_req": 2000,
    "R_min": 1
  },
  "script": {
    "exchanges": [
      {
        "label": "b1",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "reset": true
        }
      },
      {
        "label": "b2",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+3000}"
          }
        }
      },
      {
        "label": "s1",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/subscriptions"
        },
        "respond": {
          "reset": true
        }
      },
      {
        "label": "s2",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/subscriptions"
        },
        "respond": {
          "stream": [
            {
              "hold": true
            }
          ]
        }
      },
      {
        "label": "s3",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/subscriptions"
        },
        "respond": {
          "stream": [
            {
              "hold": true
            }
          ]
        }
      },
      {
        "label": "r1",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials/current/renewal"
        },
        "respond": {
          "reset": true
        }
      },
      {
        "label": "r2",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials/current/renewal"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.two",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      },
      {
        "label": "pub",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "reset": true
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "subscribe",
      "label": "sub"
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 5000
      }
    },
    {
      "op": "waitForRequest",
      "args": {
        "match": {
          "path": "/agent-credentials/current/renewal"
        },
        "count": 2,
        "timeoutMs": 6000
      }
    },
    {
      "op": "publish",
      "args": {
        "payload": 1
      },
      "label": "p"
    }
  ],
  "expect": [
    {
      "kind": "observation",
      "command": "start",
      "ok": true
    },
    {
      "kind": "request-count",
      "match": {
        "path": "/agent-credentials"
      },
      "count": 2
    },
    {
      "kind": "request-count",
      "match": {
        "path": "/agent-credentials/current/renewal"
      },
      "count": 2
    },
    {
      "kind": "observation",
      "command": "p",
      "ok": false,
      "error": {
        "type": "TransportError"
      }
    },
    {
      "kind": "request-count",
      "match": {
        "path": "/events"
      },
      "count": 1
    }
  ]
}
