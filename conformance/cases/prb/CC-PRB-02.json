{
  "id": "CC-PRB-02",
  "title": "A body that is not a JSON Problem",
  "statements": ["PRB-02"],
  "$comment": "A code or status of the wrong type makes the body not a Problem: code null. Other invalid shapes keep their string code (PRB-02).",
  "fixtures": ["problem/invalid/*"],
  "timeoutMs": 15000,
  "script": {
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      },
      {
        "label": "i1",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "status": 400,
          "fixture": "problem/invalid/code-number.json"
        }
      },
      {
        "label": "i2",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "status": 400,
          "fixture": "problem/invalid/errors-not-array.json"
        }
      },
      {
        "label": "i3",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "status": 400,
          "fixture": "problem/invalid/field-error-header-number.json"
        }
      },
      {
        "label": "i4",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "status": 400,
          "fixture": "problem/invalid/field-error-reason-number.json"
        }
      },
      {
        "label": "i5",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "status": 400,
          "fixture": "problem/invalid/status-string.json"
        }
      },
      {
        "label": "ihtml",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/events"
        },
        "respond": {
          "status": 502,
          "text": "<html><body>Bad gateway</body></html>",
          "headers": {
            "content-type": "text/html"
          }
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "publish",
      "args": {
        "payload": 1
      },
      "label": "q1"
    },
    {
      "op": "publish",
      "args": {
        "payload": 2
      },
      "label": "q2"
    },
    {
      "op": "publish",
      "args": {
        "payload": 3
      },
      "label": "q3"
    },
    {
      "op": "publish",
      "args": {
        "payload": 4
      },
      "label": "q4"
    },
    {
      "op": "publish",
      "args": {
        "payload": 5
      },
      "label": "q5"
    },
    {
      "op": "publish",
      "args": {
        "payload": 0
      },
      "label": "html"
    }
  ],
  "expect": [
    {
      "kind": "observation",
      "command": "q1",
      "ok": false,
      "error": {
        "type": "ProblemError",
        "status": 400,
        "code": null
      }
    },
    {
      "kind": "observation",
      "command": "q2",
      "ok": false,
      "error": {
        "type": "ProblemError",
        "status": 400,
        "code": "unknown_field"
      }
    },
    {
      "kind": "observation",
      "command": "q3",
      "ok": false,
      "error": {
        "type": "ProblemError",
        "status": 400,
        "code": "malformed_request"
      }
    },
    {
      "kind": "observation",
      "command": "q4",
      "ok": false,
      "error": {
        "type": "ProblemError",
        "status": 400,
        "code": "secret_rejected"
      }
    },
    {
      "kind": "observation",
      "command": "q5",
      "ok": false,
      "error": {
        "type": "ProblemError",
        "status": 400,
        "code": null
      }
    },
    {
      "kind": "observation",
      "command": "html",
      "ok": false,
      "error": {
        "type": "ProblemError",
        "status": 502,
        "code": null
      }
    }
  ]
}
