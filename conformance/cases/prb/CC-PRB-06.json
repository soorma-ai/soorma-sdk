{
  "id": "CC-PRB-06",
  "title": "A refusal before sending is retried; a TLS failure is not",
  "statements": ["PRB-08", "PRB-10"],
  "$comment": "S3 and S4 each drop the first two connections before the TLS handshake (nothing sent): bootstrap and subscribe are retried. Renewal's path is the same rule (PRB-08); the untrusted certificate fails once, never retried.",
  "timeoutMs": 15000,
  "values": {
    "H_renew": 1000,
    "R_max": 3,
    "W_max": 4000,
    "B_init": 100,
    "B_factor": 2,
    "B_cap": 400,
    "L_ends": 6,
    "W_super": 1000,
    "N_buf": 8,
    "T_idle": 1500,
    "T_req": 2000
  },
  "script": {
    "listeners": {
      "S3": {
        "refuse": 2
      },
      "S4": {
        "refuse": 2
      }
    },
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      },
      {
        "label": "sub",
        "match": {
          "listener": "S4",
          "method": "POST",
          "path": "/subscriptions"
        },
        "respond": {
          "stream": [
            {
              "hold": true
            }
          ]
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "s1"
    },
    {
      "op": "subscribe",
      "label": "sub"
    },
    {
      "op": "next",
      "args": {
        "timeoutMs": 5000
      }
    },
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${UNTRUSTED}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "c2"
    },
    {
      "op": "start",
      "label": "s2"
    }
  ],
  "expect": [
    {
      "kind": "observation",
      "command": "s1",
      "ok": true
    },
    {
      "kind": "request-count",
      "match": {
        "path": "/agent-credentials"
      },
      "count": 1
    },
    {
      "kind": "item-sequence",
      "items": [
        {
          "kind": "streamStarted"
        }
      ]
    },
    {
      "kind": "request-count",
      "match": {
        "path": "/subscriptions"
      },
      "count": 1
    },
    {
      "kind": "observation",
      "command": "s2",
      "ok": false,
      "error": {
        "type": "TransportError",
        "reason": "tls"
      }
    }
  ]
}
