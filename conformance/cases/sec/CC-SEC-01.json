{
  "id": "CC-SEC-01",
  "title": "No reference to the secret remains after bootstrap",
  "statements": ["SEC-02"],
  "timeoutMs": 15000,
  "script": {
    "exchanges": [
      {
        "label": "boot",
        "match": {
          "listener": "S3",
          "method": "POST",
          "path": "/agent-credentials"
        },
        "respond": {
          "status": 200,
          "json": {
            "credential": "soorma_ac_token.one",
            "agent": "agent-a",
            "environment": {
              "organization": "o1",
              "project": "p1",
              "environment": "e1"
            },
            "instance": "instance-1",
            "expiresAt": "${TIME:+600000}"
          }
        }
      }
    ]
  },
  "commands": [
    {
      "op": "create",
      "args": {
        "dataGatewayUrl": "${S3}",
        "eventIngestUrl": "${S4}",
        "caFile": "${CA}",
        "agent": "agent-a",
        "instance": "instance-1",
        "secret": {
          "kind": "test"
        }
      },
      "label": "create"
    },
    {
      "op": "start",
      "label": "start"
    },
    {
      "op": "inspect",
      "args": {
        "checks": ["secretRetained", "providerCalls"]
      },
      "label": "insp"
    }
  ],
  "expect": [
    {
      "kind": "observation",
      "command": "start",
      "ok": true
    },
    {
      "kind": "runtime-check",
      "command": "insp",
      "expect": {
        "/secretRetained/found": false
      }
    },
    {
      "kind": "observation",
      "command": "insp",
      "result": {
        "/providerCalls": 1
      }
    }
  ]
}
