{
  "name": "soorma-sdk-workspace",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{ts,js,json,yml,yaml}\"",
    "format": "prettier --write \"**/*.{ts,js,json,yml,yaml}\"",
    "test": "vitest run --passWithNoTests",
    "check:audit-exceptions": "node tools/audit-exceptions/check.ts",
    "checks": "node tools/checks.ts",
    "conformance": "node conformance/runner/src/cli.ts",
    "conformance:reference": "node conformance/runner/src/cli.ts run --mode reference --driver \"node --expose-gc conformance/reference-driver/src/driver.ts\"",
    "conformance:self-test": "node conformance/runner/src/self-test.ts",
    "e2e:core-up": "node e2e/src/cli/core-up.ts",
    "e2e:setup": "node e2e/src/cli/setup.ts",
    "e2e:prove-stack": "node e2e/src/cli/prove-stack.ts",
    "e2e:core-down": "node e2e/src/cli/core-down.ts",
    "e2e:scenario-typescript": "vitest run --config typescript/e2e/vitest.config.ts",
    "package:typescript": "node tools/package-typescript/check.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "eslint": "10.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
